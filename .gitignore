# Dependencies are installed per package, never committed.
node_modules/

# npm cache used by the sandboxed install path.
.npm-cache/

# Sanitised verification state: regenerated by .verify/run.sh and friends.
.verify/dsh-home/
.verify/xdg-*/
.verify/pnpm-store/
.verify/pnpm-home/
.verify/pylibs/
.verify/fonts/
.verify/previews/
.verify/geometry.json
.verify/plugin.patch.yml
.verify/cookies*.txt
.verify/index*.html
.verify/*.js.tmp

# The upstream VK-1 snapshot used as a reference while porting. Kept locally,
# never committed: it is a third-party checkout with no license attached, and
# every asset this project actually ships is already copied into
# dsh-vk1-pet/assets/ with its SHA-256 recorded.
repo/

.DS_Store
*.log
